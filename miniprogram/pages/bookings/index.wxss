.bookings-page {
  padding-top: 48rpx;
}

.hero {
  margin-bottom: 42rpx;
}

.section-title,
.intro,
.time,
.arrow {
  display: block;
}

.section-title {
  margin-top: 18rpx;
}

.intro {
  color: #7b736d;
  font-size: 25rpx;
  margin-top: 16rpx;
}

.booking-card {
  background: #fff;
  border: 1rpx solid #e6e0da;
  border-radius: 12rpx;
  margin-bottom: 22rpx;
  padding: 30rpx;
}

.card-top {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.service-name {
  font-family: "Songti SC", serif;
  font-size: 33rpx;
}

.time {
  color: #625b56;
  font-size: 26rpx;
  margin-top: 22rpx;
}

.arrow {
  color: #9a7460;
  font-size: 22rpx;
  margin-top: 24rpx;
}

.state {
  color: #8b827a;
  padding: 130rpx 0;
  text-align: center;
}
