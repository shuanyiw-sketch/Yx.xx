.profile-page {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

.profile-hero {
  align-items: center;
  background: #e9e1d8;
  display: flex;
  flex-direction: column;
  padding: 72rpx 44rpx 64rpx;
  text-align: center;
}

.portrait-mark {
  align-items: center;
  background: #2c2926;
  border-radius: 50%;
  color: #f4efe9;
  display: flex;
  font-family: "Songti SC", serif;
  font-size: 54rpx;
  height: 144rpx;
  justify-content: center;
  margin-bottom: 28rpx;
  width: 144rpx;
}

.name {
  font-family: "Songti SC", serif;
  font-size: 50rpx;
  margin-top: 14rpx;
}

.introduction {
  color: #6e655e;
  font-size: 26rpx;
  line-height: 1.8;
  margin-top: 24rpx;
  max-width: 600rpx;
}

.owner-entry {
  background: #2c2926;
  border-radius: 999rpx;
  color: #fff;
  font-size: 23rpx;
  line-height: 68rpx;
  margin-top: 30rpx;
  padding: 0 28rpx;
}

.owner-entry::after {
  border: none;
}

.section {
  margin: 52rpx 32rpx 0;
}

.section-label {
  display: block;
  font-family: "Songti SC", serif;
  font-size: 34rpx;
  margin-bottom: 24rpx;
}

.works {
  white-space: nowrap;
  width: 100%;
}

.work-card {
  display: inline-block;
  margin-right: 22rpx;
  vertical-align: top;
  white-space: normal;
  width: 290rpx;
}

.info-card,
.policy-card {
  background: #fff;
  border: 1rpx solid #e7e0d9;
  border-radius: 12rpx;
  padding: 32rpx;
}

.info-text {
  color: #655e58;
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.copy-tip {
  color: #9a7460;
  display: block;
  font-size: 21rpx;
  margin-top: 18rpx;
}

.state {
  color: #8b827a;
  padding: 180rpx 32rpx;
  text-align: center;
}
