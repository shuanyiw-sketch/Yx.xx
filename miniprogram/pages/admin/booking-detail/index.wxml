<view class="page-shell" wx:if="{{booking}}"><booking-status status="{{booking.status}}"/><text class="section-title title">{{booking.serviceSnapshot.name}}</text><text class="muted time">{{booking.displayTime}} · {{booking.customer.name}} {{booking.customer.phone}}</text><view class="actions"><button wx:if="{{booking.status === 'pending'}}" data-command="confirm" bindtap="command">确认</button><button wx:if="{{booking.status === 'pending'}}" data-command="reject" bindtap="command">拒绝</button><button wx:if="{{booking.status === 'cancel_requested'}}" data-command="acceptCancel" bindtap="command">同意取消</button><button wx:if="{{booking.status === 'confirmed'}}" data-command="complete" bindtap="command">标记完成</button></view><view class="admin-card"><text class="admin-label">线下收款记录（元）</text><input class="admin-input" type="digit" value="{{amountYuan}}" bindinput="updateAmount" placeholder="例如 300"/><view class="types"><text class="type {{receiptType === 'deposit' ? 'selected' : ''}}" data-type="deposit" bindtap="chooseReceiptType">订金</text><text class="type {{receiptType === 'final' ? 'selected' : ''}}" data-type="final" bindtap="chooseReceiptType">尾款</text></view><button class="admin-button" bindtap="recordReceipt">记录线下收款</button><text class="muted total">已记录 ¥{{booking.receivedTotalFen / 100 || 0}}</text></view></view>
