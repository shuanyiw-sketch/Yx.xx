<view class="page-shell"><text class="eyebrow">SERVICES</text><text class="section-title title">服务管理</text><view class="admin-card"><view class="admin-field"><text class="admin-label">服务名称</text><input class="admin-input" data-field="name" bindinput="update"/></view><view class="admin-field"><text class="admin-label">说明</text><input class="admin-input" data-field="description" bindinput="update"/></view><view class="admin-field"><text class="admin-label">参考价（元）</text><input class="admin-input" type="digit" data-field="referencePriceYuan" bindinput="update"/></view><view class="admin-field"><text class="admin-label">服务时长（分钟）</text><input class="admin-input" type="number" value="{{form.durationMinutes}}" data-field="durationMinutes" bindinput="update"/></view><view class="admin-field"><text class="admin-label">前 / 后缓冲（分钟）</text><view class="double"><input class="admin-input" type="number" value="{{form.bufferBeforeMinutes}}" data-field="bufferBeforeMinutes" bindinput="update"/><input class="admin-input" type="number" value="{{form.bufferAfterMinutes}}" data-field="bufferAfterMinutes" bindinput="update"/></view></view><button class="admin-button" bindtap="save">保存并发布</button></view><view class="admin-card"><view wx:for="{{services}}" wx:key="id" class="admin-list-row"><text>{{item.name}}</text><text class="danger" data-id="{{item.id}}" bindtap="unpublish">下架</text></view></view></view>
