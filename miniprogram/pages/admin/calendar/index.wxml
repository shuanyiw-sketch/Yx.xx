<view class="page-shell"><text class="eyebrow">CALENDAR</text><text class="section-title title">全部档期</text><view class="admin-card"><view wx:for="{{bookings}}" wx:key="id" class="admin-list-row" data-id="{{item.id}}" bindtap="open"><view><text class="name">{{item.serviceSnapshot.name}}</text><text class="muted time">{{item.displayTime}}</text></view><booking-status status="{{item.status}}" /></view><text wx:if="{{!bookings.length && !loading}}" class="muted">暂无档期记录</text></view></view>
