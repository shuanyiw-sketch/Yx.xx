<view class="page-shell"><text class="eyebrow">CALENDAR</text><text class="section-title title">全部档期</text><view class="admin-card"><view wx:for="{{entries}}" wx:key="id" class="admin-list-row {{item.kind}}" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="open"><view><text class="name">{{item.kind === 'booking' ? item.serviceSnapshot.name : (item.note || '临时占用')}}</text><text class="muted time">{{item.displayTime}}</text><text wx:if="{{item.kind === 'exception'}}" class="exception-label">特殊档期 · {{item.type}}</text><text wx:if="{{item.kind === 'offline_booking'}}" class="exception-label">线下预约</text></view><booking-status wx:if="{{item.kind === 'booking'}}" status="{{item.status}}" /></view><text wx:if="{{!entries.length && !loading}}" class="muted">暂无档期记录</text></view></view>
