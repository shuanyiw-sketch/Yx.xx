<view class="page-shell"><text class="eyebrow">CUSTOMERS</text><text class="section-title title">客户记录</text><view class="admin-card"><view wx:for="{{customers}}" wx:key="userId" class="admin-list-row" data-id="{{item.userId}}" bindtap="open"><view><text>{{item.customer.name}}</text><text class="phone">{{item.customer.phone}}</text></view><text>→</text></view><text wx:if="{{!customers.length}}" class="muted">暂无客户记录</text></view><view wx:if="{{selected}}" class="admin-card"><text class="name">{{selected.customer.name}}</text><text class="muted">历史预约 {{selected.bookings.length}} 次</text></view></view>
