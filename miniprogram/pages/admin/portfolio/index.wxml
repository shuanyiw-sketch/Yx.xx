<view class="page-shell"><text class="eyebrow">PORTFOLIO</text><text class="section-title title">作品管理</text><view class="admin-card"><view class="admin-field"><text class="admin-label">作品标题</text><input class="admin-input" data-field="title" bindinput="update"/></view><view class="admin-field"><text class="admin-label">作品说明</text><textarea class="admin-input notes" data-field="summary" bindinput="update"/></view><button class="admin-button" loading="{{saving}}" bindtap="chooseAndUpload">选择图片并保存草稿</button></view><view class="admin-card"><view wx:for="{{items}}" wx:key="id" class="admin-list-row"><text>{{item.title}}</text><text class="publish" data-id="{{item.id}}" bindtap="publish">发布</text></view></view></view>
