<view class="page-shell"><text class="eyebrow">PROFILE</text><text class="section-title title">主页设置</text><view class="admin-card"><view class="admin-field"><text class="admin-label">名称</text><input class="admin-input" value="{{form.name}}" data-field="name" bindinput="update"/></view><view class="admin-field"><text class="admin-label">个人介绍</text><textarea class="admin-input area" value="{{form.introduction}}" data-field="introduction" bindinput="update"/></view><view class="admin-field"><text class="admin-label">联系方式</text><textarea class="admin-input area" value="{{form.contactText}}" data-field="contactText" bindinput="update"/></view><view class="admin-field"><text class="admin-label">预约须知</text><textarea class="admin-input area" value="{{form.bookingPolicy}}" data-field="bookingPolicy" bindinput="update"/></view><button class="admin-button" bindtap="save">保存主页</button></view></view>
