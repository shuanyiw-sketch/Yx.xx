<view class="page-shell"><text class="eyebrow">AVAILABILITY</text><text class="section-title title">每周可预约时间</text><view class="admin-card"><view class="admin-field"><text class="admin-label">星期（0 周日，1 周一）</text><input class="admin-input" type="number" value="{{weekday}}" data-field="weekday" bindinput="update"/></view><view class="admin-field"><text class="admin-label">开始小时</text><input class="admin-input" type="number" value="{{startHour}}" data-field="startHour" bindinput="update"/></view><view class="admin-field"><text class="admin-label">结束小时</text><input class="admin-input" type="number" value="{{endHour}}" data-field="endHour" bindinput="update"/></view><button class="admin-button" bindtap="saveRule">保存规则</button></view><view class="admin-card"><text class="section-label">新增特殊档期</text><view class="admin-field"><text class="admin-label">类型</text><picker range="{{exceptionTypeOptions}}" range-key="label" value="{{exceptionTypeIndex}}" bindchange="selectExceptionType"><view class="admin-input">{{exceptionTypeOptions[exceptionTypeIndex].label}}</view></picker></view><view class="admin-field"><text class="admin-label">开始时间戳（毫秒）</text><input class="admin-input" type="number" value="{{exceptionStartMs}}" data-field="exceptionStartMs" bindinput="update"/></view><view class="admin-field"><text class="admin-label">结束时间戳（毫秒）</text><input class="admin-input" type="number" value="{{exceptionEndMs}}" data-field="exceptionEndMs" bindinput="update"/></view><view class="admin-field"><text class="admin-label">说明</text><input class="admin-input" value="{{exceptionNote}}" data-field="exceptionNote" bindinput="update"/></view><button class="admin-button" bindtap="saveException">保存特殊档期</button></view><view class="admin-card"><text class="section-label">已有特殊档期</text><view wx:for="{{exceptions}}" wx:key="id" class="exception-row"><text>{{item.displayTime}}</text><text class="muted">{{item.typeLabel}} · {{item.note || '无备注'}}</text></view><text wx:if="{{!exceptions.length}}" class="muted">暂无特殊档期</text></view></view>
