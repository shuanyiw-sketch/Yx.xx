<view class="page-shell detail-page">
  <view wx:if="{{loading}}" class="state">正在读取预约…</view>
  <view wx:elif="{{errorMessage}}" class="state">{{errorMessage}}</view>
  <block wx:elif="{{booking}}">
    <view class="header">
      <booking-status status="{{booking.status}}" />
      <text class="title">{{booking.serviceSnapshot.name}}</text>
      <text class="time">{{booking.displayTime}}</text>
    </view>

    <view class="card">
      <view class="row"><text class="label">联系人</text><text>{{booking.customer.name}}</text></view>
      <view class="row"><text class="label">手机号</text><text>{{booking.customer.phone}}</text></view>
      <view class="row"><text class="label">地点</text><text>{{booking.location || '待沟通'}}</text></view>
      <view class="row"><text class="label">人数</text><text>{{booking.peopleCount || '待沟通'}}</text></view>
      <view class="row row-block"><text class="label">补充需求</text><text>{{booking.notes || '无'}}</text></view>
    </view>

    <view class="price-note">
      <text>参考价 ¥{{booking.serviceSnapshot.referencePriceFen / 100}}</text>
      <text>费用与收款在线下确认，小程序不处理付款或退款。</text>
    </view>

    <button
      wx:if="{{canWithdraw}}"
      class="secondary-action"
      data-command="withdraw"
      bindtap="command"
    >撤回预约</button>
    <button
      wx:if="{{canRequestCancel}}"
      class="secondary-action"
      data-command="requestCancel"
      bindtap="command"
    >申请取消</button>
  </block>
</view>
